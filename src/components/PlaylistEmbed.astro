---
import Icon from './Icon.astro';

interface Props {
  playlistId: string;
  title?: string;
}

const { playlistId, title = 'Nafis Al-Muhsin — popular videos' } = Astro.props;
---

<div class="playlist-shell" data-playlist-shell data-playlist-id={playlistId} data-playlist-title={title}>
  <div class="playlist-art" aria-hidden="true">
    <div class="rings"></div>
    <Icon name="youtube" size={42} />
  </div>
  <div class="playlist-copy">
    <span>Updated directly from YouTube</span>
    <h3>Popular videos, in one place.</h3>
    <p>This playlist follows Nafis’s YouTube collection, so newly added favourites appear here automatically.</p>
    <div class="playlist-actions">
      <button class="button" type="button" data-load-playlist><Icon name="play" /> Play popular videos</button>
      <a class="text-link" href={`https://www.youtube.com/playlist?list=${playlistId}`} target="_blank" rel="noopener">Open on YouTube <Icon name="external" size={16} /></a>
    </div>
  </div>
</div>

<style>
  .playlist-shell { display: grid; min-height: 310px; grid-template-columns: minmax(260px,.78fr) minmax(0,1.22fr); overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper); box-shadow: var(--shadow); }
  .playlist-art { position: relative; display: grid; min-height: 310px; place-items: center; overflow: hidden; color: white; background: radial-gradient(circle at 65% 25%,rgba(255,255,255,.18),transparent 30%),linear-gradient(145deg,var(--gold-soft),var(--surface-strong)); }
  .playlist-art::before { content: ''; position: absolute; inset: 12%; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; }
  .rings { position: absolute; width: 58%; aspect-ratio: 1; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; box-shadow: 0 0 0 38px rgba(255,255,255,.035),0 0 0 76px rgba(255,255,255,.025); }
  .playlist-art :global(svg) { position: relative; z-index: 1; }
  .playlist-copy { align-self: center; padding: clamp(1.6rem,5vw,4rem); }
  .playlist-copy > span { color: var(--emerald); font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .playlist-copy h3 { max-width: 13ch; margin: .65rem 0 .8rem; font-size: clamp(2rem,4vw,3.4rem); }
  .playlist-copy p { max-width: 52ch; color: var(--ink-soft); }
  .playlist-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.5rem; }
  .text-link { display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; text-decoration: none; }
  .playlist-shell.is-playing { display: block; min-height: 0; aspect-ratio: 16 / 9; }
  .playlist-shell.is-playing :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  @media (max-width: 700px) { .playlist-shell { grid-template-columns: 1fr; }.playlist-art { min-height: 190px; }.playlist-copy { padding: 1.4rem; } }
</style>

<script>
  function setupPlaylists() {
    document.querySelectorAll<HTMLElement>('[data-playlist-shell]').forEach((shell) => {
      const button = shell.querySelector<HTMLButtonElement>('[data-load-playlist]');
      if (!button || button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/videoseries?list=${encodeURIComponent(shell.dataset.playlistId || '')}&autoplay=1&rel=0`;
        iframe.title = shell.dataset.playlistTitle || 'YouTube playlist';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        shell.classList.add('is-playing');
        shell.replaceChildren(iframe);
        (window as any).plausible?.('Video Play', { props: { video: 'popular-playlist' } });
      });
    });
  }
  setupPlaylists();
  document.addEventListener('astro:page-load', setupPlaylists);
</script>
