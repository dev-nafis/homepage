---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
}

const { eyebrow = 'Stay connected', heading = 'Follow Nafis', description } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<div class:list={['social-dock', { 'has-media': hasMedia }]}>
  {hasMedia && <div class="social-dock-media"><slot name="media" /></div>}
  <div class="social-dock-heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="social-dock-title">{heading}</h2>
    {description && <p>{description}</p>}
  </div>
  <nav class="social-dock-links" aria-label="Follow Nafis on social media">
    {site.socials.map((social) => (
      <a class={`social-${social.icon}`} href={social.url} target="_blank" rel="me noopener" data-social-link={social.name} aria-label={`Follow Nafis on ${social.name} (opens in a new tab)`}>
        <span class="social-brand" aria-hidden="true"><Icon name={social.icon} size={28} /></span>
        <span class="social-name">{social.name}</span>
        <Icon name="external" size={15} />
      </a>
    ))}
  </nav>
</div>

<style>
  .social-dock { display: grid; gap: 1.1rem; }
  .social-dock.has-media { grid-template-columns: 112px minmax(0,1fr); align-items: center; column-gap: 1.25rem; }
  .social-dock-media { overflow: hidden; width: 112px; aspect-ratio: 1; border-radius: 1rem; background: var(--teal-soft); }
  .social-dock-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .social-dock.has-media .social-dock-links { grid-column: 1 / -1; }
  .social-dock-heading .eyebrow { margin-bottom: .55rem; }
  .social-dock-heading h2 { margin: 0; font-size: clamp(1.3rem,2.3vw,1.8rem); }
  .social-dock-heading p:not(.eyebrow) { margin: .45rem 0 0; color: var(--ink-soft); }
  .social-dock-links { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .65rem; justify-content: center; }
  .social-dock-links a { display: grid; min-width: 0; min-height: 68px; grid-template-columns: 44px minmax(0,1fr) auto; align-items: center; gap: .5rem; padding: .5rem .6rem; border: 1px solid var(--line); border-radius: 1rem; color: var(--ink); background: var(--paper-raised); box-shadow: var(--shadow-soft); font-size: .82rem; font-weight: 700; text-decoration: none; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .social-dock-links a:hover { border-color: var(--brand); box-shadow: 0 12px 24px color-mix(in srgb,var(--brand) 18%,transparent); transform: translateY(-2px); }
  .social-brand { display: grid; width: 44px; height: 44px; place-items: center; border-radius: .8rem; color: #fff; background: var(--brand); }
  .social-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .social-dock-links > a > :last-child { color: var(--ink-soft); }
  .social-instagram { --brand: #d94a79; }.social-instagram .social-brand { background: linear-gradient(145deg,#6e3ab2,#d94a79,#e7a24f); }
  .social-youtube { --brand: #e52424; }
  .social-tiktok { --brand: #202020; }
  .social-spotify { --brand: #1db954; }.social-spotify .social-brand { color: #0a201c; }
  @media (max-width: 560px) {
    .social-dock.has-media { grid-template-columns: 80px minmax(0,1fr); gap: .85rem 1rem; }
    .social-dock-media { width: 80px; border-radius: .85rem; }
    .social-dock-links { grid-template-columns: repeat(2,minmax(0,1fr)); gap: .65rem; }
    .social-dock-links a { min-height: 72px; grid-template-columns: 44px minmax(0,1fr) 14px; justify-items: stretch; gap: .4rem; padding: .55rem; font-size: .72rem; text-align: left; }
    .social-brand { width: 44px; height: 44px; border-radius: .75rem; }
    .social-brand :global(svg) { width: 25px; height: 25px; }
    .social-name { width: auto; overflow: hidden; text-overflow: ellipsis; }
    .social-dock-links > a > :last-child { display: block; align-self: center; }
  }
</style>
