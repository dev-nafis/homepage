---
import Icon from './Icon.astro';
import { slugifyChapter, formatDuration } from '../lib/quran';
import { withBase } from '../lib/route';
import type { QuranChapter, Recitation } from '../types';

interface Props { chapter: QuranChapter; recitation?: Recitation; compact?: boolean; }
const { chapter, recitation, compact = false } = Astro.props;
const slug = slugifyChapter(chapter);
---
<article class:list={['surah-card', 'card', { recorded: !!recitation, compact }]} data-surah-card data-search={`${chapter.id} ${chapter.transliteration} ${chapter.translation} ${chapter.name}`.toLowerCase()} data-recorded={recitation ? 'true' : 'false'}>
  <a class="surah-link" href={withBase(`/quran/${slug}/`)} aria-label={`Open ${chapter.transliteration}`}>
    <span class="surah-number">{String(chapter.id).padStart(3, '0')}</span>
    <span class="surah-copy">
      <strong>{chapter.transliteration}</strong>
      <small>{chapter.translation} · {chapter.total_verses} ayat</small>
    </span>
    <span class="surah-arabic" lang="ar" dir="rtl" translate="no">{chapter.name}</span>
  </a>
  <div class="surah-actions">
    {recitation ? (
      <>
        <span class="recording-badge">Nafis recording</span>
        <span class="duration">{formatDuration(recitation.duration)}</span>
        <button
          class="card-play"
          type="button"
          aria-label={`Play ${recitation.title}`}
          data-play-track
          data-audio={recitation.audio}
          data-title={recitation.title}
          data-surah={recitation.surahId}
          data-url={withBase(`/quran/${slug}/`)}
          data-cues={JSON.stringify(recitation.cues)}
        ><Icon name="play" size={17} /></button>
      </>
    ) : <span class="unrecorded">Read now</span>}
  </div>
</article>

<style>
  .surah-card { position: relative; display: grid; min-width: 0; overflow: hidden; transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease; }
  .surah-card::before { position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--gold); content: ''; opacity: 0; transition: opacity 180ms ease; }
  .surah-card:hover { border-color: color-mix(in srgb,var(--emerald) 35%,var(--line)); box-shadow: var(--shadow); transform: translateY(-3px); }
  .surah-card.recorded::before { opacity: 1; }
  .surah-link { display: grid; min-width: 0; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: 1rem; padding: 1.15rem 1.15rem .65rem; text-decoration: none; }
  .surah-number { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border: 1px solid var(--line); border-radius: 50% 50% 50% 14%; color: var(--emerald); background: var(--teal-soft); font-size: .69rem; font-weight: 700; }
  .surah-copy { min-width: 0; }
  .surah-copy strong, .surah-copy small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .surah-copy strong { font-family: 'Playfair Display', serif; font-size: 1.14rem; }
  .surah-copy small { margin-top: .2rem; color: var(--ink-soft); font-size: .76rem; }
  .surah-arabic { color: var(--emerald); font: 600 1.35rem 'Noto Naskh Arabic',serif; }
  .surah-actions { display: flex; min-height: 43px; align-items: center; gap: .6rem; margin-inline: 1.15rem; padding: .65rem 0 .9rem; border-top: 1px solid var(--line); }
  .recording-badge { padding: .25rem .55rem; border-radius: 999px; color: var(--emerald); background: var(--teal-soft); font-size: .65rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .duration, .unrecorded { margin-left: auto; color: var(--ink-soft); font-size: .75rem; }
  .card-play { display: grid; width: 34px; height: 34px; padding: 0; place-items: center; border: 0; border-radius: 50%; color: var(--accent-ink); background: var(--emerald); cursor: pointer; }
  .card-play:hover { background: var(--emerald-bright); transform: scale(1.05); }
  .compact .surah-actions { display: none; }
  @media (max-width: 420px) { .surah-link { grid-template-columns: auto minmax(0,1fr); } .surah-arabic { grid-column: 2; } }
</style>
