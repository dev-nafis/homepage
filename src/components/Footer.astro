---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { withBase } from '../lib/route';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>{site.name}</strong>
      <span>Qur’an reciter</span>
    </div>
    <div class="footer-links">
      <div><strong>Explore</strong>{site.nav.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      <div><strong>Follow</strong>{site.socials.map((social) => <a href={social.url} target="_blank" rel="me noopener">{social.name}</a>)}</div>
      <div><strong>Details</strong><a href={withBase('/privacy/')}>Privacy</a></div>
    </div>
  </div>
  <div class="container footer-base">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span class="footer-note"><Icon name="heart" size={15} /> Made with care for listeners everywhere.</span>
  </div>
</footer>

<style>
  .site-footer { padding: clamp(2.5rem,5vw,4rem) 0 1.5rem; border-top: 1px solid var(--line); background: var(--paper-muted); }
  .footer-grid { display: grid; grid-template-columns: minmax(150px,.65fr) 1fr; gap: clamp(2rem,6vw,6rem); align-items: start; }
  .footer-brand { display: grid; gap: .4rem; }
  .footer-brand strong { font: 700 clamp(1.25rem,2vw,1.7rem) 'Playfair Display',serif; }
  .footer-brand span { color: var(--ink-soft); font-size: .85rem; }
  .footer-links { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; align-content: start; }
  .footer-links div { display: grid; gap: .65rem; }
  .footer-links strong { margin-bottom: .35rem; color: var(--emerald); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
  .footer-links a { width: fit-content; color: var(--ink-soft); text-decoration: none; }
  .footer-links a:hover { color: var(--emerald); }
  .footer-base { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: .82rem; }
  .footer-note { display: flex; align-items: center; gap: .4rem; }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr; } .footer-links { grid-template-columns: repeat(2,1fr); } .footer-base { display: grid; } }
</style>
