---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import PlaylistEmbed from '../components/PlaylistEmbed.astro';
import Icon from '../components/Icon.astro';
import type { Video } from '../types';

const videos = (await getCollection('videos')).map(({ id, data }) => ({ id, ...data, publishedAt: data.publishedAt.toISOString() })).sort((a,b) => b.publishedAt.localeCompare(a.publishedAt)) as Video[];
const structuredData = videos.map((video) => ({ '@context': 'https://schema.org', '@type': 'VideoObject', name: video.title, thumbnailUrl: video.thumbnail, uploadDate: video.publishedAt, contentUrl: video.url, creator: { '@type': 'Person', name: 'Nafis Al-Muhsin' } }));
---
<BaseLayout title="Visual Qur’an Videos" description="Watch visual Qur’an recitations and translation videos created by Nafis Al-Muhsin." structuredData={structuredData}>
  <header class="page-hero"><div class="orb"></div><div class="pattern"></div><div class="container reveal"><p class="eyebrow">Visual Qur’an</p><h1>Words you can hear, see, and carry.</h1><p class="lead">Cinematic recitations and clear translations made for attentive listening and meaningful sharing.</p></div></header>
  <section class="section-sm video-library">
    <div class="container">
      <PlaylistEmbed playlistId="PLSw26XuZVejA" />
      {videos.length > 0 && <div class="archive-heading"><p class="eyebrow">Selected videos</p><h2>From the archive.</h2></div>}
      {videos.length > 0 && <div class="video-grid">{videos.map((video, index) => <VideoCard video={video} large={index === 0} />)}</div>}
    </div>
  </section>
  <section class="section creator-cta"><div class="narrow reveal"><p class="eyebrow">YouTube</p><h2>Subscribe for every new visual recitation.</h2><p class="lead">Long-form recitations, translations, and reflective short videos—all in one place.</p><a class="button" href="https://www.youtube.com/@nafis_almuhsin" target="_blank" rel="noopener">Visit the channel <Icon name="external" /></a></div></section>
</BaseLayout>

<style>
  .page-hero .pattern { color: var(--emerald); }
  .video-library { background: var(--paper-raised); }
  .video-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.5rem; }
  .archive-heading { margin: clamp(3rem,7vw,6rem) 0 1.5rem; }
  .video-grid > :first-child { grid-column: 1/-1; }
  .empty-state { padding: clamp(2rem,5vw,5rem); text-align: center; }
  .creator-cta { text-align: center; background: var(--teal-soft); }
  .creator-cta .eyebrow { justify-content: center; }.creator-cta .lead { margin-inline: auto; }
  @media (max-width: 700px) { .video-grid { grid-template-columns: 1fr; }.video-grid > :first-child { grid-column: auto; } }
</style>
