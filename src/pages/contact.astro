---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SocialDock from '../components/SocialDock.astro';
const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT;
const configured = !!endpoint && !endpoint.includes('your-form-id');
---
<BaseLayout title="Contact" description="Contact Nafis Al-Muhsin for recitation requests, events, bookings, and creative collaborations.">
  <header class="page-hero contact-hero"><div class="orb"></div><div class="pattern"></div><div class="container reveal"><p class="eyebrow">Get in touch</p><h1>Let’s create something meaningful.</h1><p class="lead">Recitation requests, event invitations, and creative collaborations are welcome. Share enough detail to make the first reply useful.</p></div></header>
  <section class="section-sm contact-section"><div class="container contact-grid">
    <div class="contact-aside reveal">
      <p class="eyebrow">Before you send</p><h2>A few helpful details.</h2>
      <ul><li><span>01</span><div><strong>What is the project?</strong><p>Tell me whether this is an event, recitation, video, or another collaboration.</p></div></li><li><span>02</span><div><strong>When is it happening?</strong><p>Include your preferred date or deadline and your time zone.</p></div></li><li><span>03</span><div><strong>Where will it be shared?</strong><p>Note the venue, platform, audience, and intended use.</p></div></li></ul>
      <div class="response-note card"><Icon name="mail" /><p><strong>Thoughtful enquiries</strong><br />Every genuine message is read. Response time depends on current recording and production commitments.</p></div>
    </div>
    <div class="form-card card reveal">
      <form id="enquiry-form" action={endpoint || ''} method="POST" data-contact-form data-configured={String(configured)} novalidate>
        <div class="form-heading"><span>Enquiry form</span><p>Fields marked * are required.</p></div>
        <div class="field-row"><label><span>Name *</span><input type="text" name="name" autocomplete="name" required /></label><label><span>Email *</span><input type="email" name="email" autocomplete="email" required /></label></div>
        <label><span>Enquiry type *</span><select name="enquiry_type" required><option value="">Choose one</option><option value="Creative collaboration">Creative collaboration</option><option value="Event or booking">Event or booking</option><option value="Recitation request">Recitation request</option><option value="General enquiry">General enquiry</option></select></label>
        <label><span>Project or event date</span><input type="date" name="event_date" /></label>
        <label><span>Message *</span><textarea name="message" rows="7" minlength="20" required placeholder="Tell me about the idea, audience, timing, and where the work will be used."></textarea></label>
        <label class="consent"><input type="checkbox" name="consent" required /><span>I agree that my details may be used to respond to this enquiry. *</span></label>
        <input class="honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="button" type="submit">Send enquiry <Icon name="arrow" /></button>
        <p class="form-status" role="status" aria-live="polite" data-form-status>{configured ? 'Your details are used only to respond to this enquiry.' : 'The contact form is awaiting its secure Formspree endpoint. Please use a social channel in the meantime.'}</p>
      </form>
    </div>
  </div></section>
  <section class="section-sm social-contact"><div class="container reveal"><SocialDock heading="Prefer a social channel?" description="Follow Nafis where you already listen and watch." /></div></section>
</BaseLayout>

<style>
  .contact-hero .pattern { color: var(--emerald); }.contact-hero h1 { max-width: 12ch; }
  .contact-section { background: var(--paper-raised); }
  .contact-grid { display: grid; grid-template-columns: .78fr 1.22fr; gap: clamp(2rem,7vw,7rem); align-items: start; }
  .contact-aside { position: sticky; top: calc(var(--header-height) + 2rem); }
  .contact-aside ul { display: grid; gap: 1rem; padding: 0; list-style: none; }
  .contact-aside li { display: grid; grid-template-columns: 2.3rem 1fr; gap: .8rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .contact-aside li > span { color: var(--gold); font-size: .7rem; font-weight: 700; }
  .contact-aside li p { margin: .25rem 0 0; color: var(--ink-soft); font-size: .86rem; }
  .response-note { display: flex; gap: .8rem; margin-top: 2rem; padding: 1rem; color: var(--emerald); }
  .response-note p { margin: 0; color: var(--ink-soft); font-size: .8rem; }.response-note strong { color: var(--ink); }
  .form-card { padding: clamp(1.2rem,4vw,2.5rem); }
  form { display: grid; gap: 1.1rem; }
  .form-heading { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }.form-heading span { font: 700 1.3rem 'Playfair Display',serif; }.form-heading p { margin: 0; color: var(--ink-soft); font-size: .75rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { display: grid; gap: .4rem; color: var(--ink); font-size: .8rem; font-weight: 600; }
  input, select, textarea { width: 100%; min-height: 48px; padding: .7rem .85rem; border: 1px solid var(--line); border-radius: .7rem; color: var(--ink); background: var(--paper); outline: 0; }
  textarea { resize: vertical; }
  input:focus, select:focus, textarea:focus { border-color: var(--emerald); box-shadow: 0 0 0 3px color-mix(in srgb,var(--emerald) 18%,transparent); }
  [aria-invalid='true'] { border-color: #b54c45; }
  .consent { display: flex; align-items: start; gap: .65rem; font-weight: 400; }.consent input { width: 19px; min-height: 19px; margin-top: .15rem; accent-color: var(--emerald); }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .form-status { margin: 0; color: var(--ink-soft); font-size: .75rem; }
  .form-status.success { color: var(--emerald); }.form-status.error { color: #b54c45; }
  .social-contact { background: var(--teal-soft); }
  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; }.contact-aside { position: static; }.field-row { grid-template-columns: 1fr; } }
</style>

<script>
  function setupForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const status = document.querySelector<HTMLElement>('[data-form-status]');
    if (!form || !status || form.dataset.ready) return;
    form.dataset.ready = 'true';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      form.querySelectorAll('[aria-invalid]').forEach((field) => field.removeAttribute('aria-invalid'));
      if (!form.checkValidity()) {
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(':invalid').forEach((field) => field.setAttribute('aria-invalid', 'true'));
        status.textContent = 'Please complete the required fields and check your email address.'; status.className = 'form-status error'; form.reportValidity(); return;
      }
      if (form.dataset.configured !== 'true') { status.textContent = 'This form is not active yet. Please use one of the social links below.'; status.className = 'form-status error'; return; }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true; status.textContent = 'Sending your enquiry…'; status.className = 'form-status';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Submission failed');
        form.reset(); status.textContent = 'Thank you—your enquiry has been sent successfully.'; status.className = 'form-status success'; (window as any).plausible?.('Enquiry Submitted');
      } catch { status.textContent = 'The message could not be sent. Please try again or use a social channel below.'; status.className = 'form-status error'; }
      finally { button.disabled = false; }
    });
  }
  setupForm();
  document.addEventListener('astro:page-load', setupForm);
</script>
